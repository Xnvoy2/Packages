# Copy to .env.local and fill in. Every .env file is git-ignored and must
# never be committed.

# Postgres. Without it the api refuses to start unless PACKAGES_DEV_DB=memory.
# Use the pooled connection string, and sslmode=verify-full so a future pg
# release cannot silently weaken TLS.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full"

# Local development only: runs the same SQL against an in-memory database.
# Everything is lost on restart. Never set this in production.
PACKAGES_DEV_DB="memory"

# Signs session cookies and encrypts stored GitHub tokens at rest. Without it
# the server generates an ephemeral key and warns; rotating it signs everyone
# out and makes stored tokens undecryptable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PACKAGES_SESSION_SECRET=""
PACKAGES_SESSION_TTL_DAYS=14

# Runs the api inside the site server: one process, one port, migrations
# applied on boot. This is what production uses.
PACKAGES_EMBED_API=1

# The port, and the origin the site is served from. In production the origin
# must be https or the session cookie cannot be marked Secure.
PORT=4789
HOST=127.0.0.1
PACKAGES_SITE_ORIGIN="http://127.0.0.1:4789"

# GitHub OAuth app. Sign-in is disabled and the site says so until both are
# set. The callback must match the OAuth app's registration exactly.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://127.0.0.1:4789/api/auth/github/callback"

# Strongly recommended. Unauthenticated GitHub reads are limited to 60 an
# hour for the whole server, which real traffic exhausts immediately. A
# fine-grained token with no scopes raises it to 5000.
GITHUB_READ_TOKEN=""

# Solana. The identity program is not deployed, so this is empty and every
# onchain surface reports that it is awaiting deployment.
SOLANA_RPC_URL="https://api.devnet.solana.com"
PACKAGES_PROGRAM_ID=""

# Build-time only. Without it the build writes no canonical urls, no social
# tags and no sitemap, rather than inventing an origin.
# PACKAGES_SITE_URL="https://example.com"
