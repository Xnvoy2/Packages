{
  "name": "packages-identity",
  "private": true,
  "version": "1.0.0",
  "description": "Packages: a verified public identity on Solana for npm packages.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/build.js",
    "start": "node tools/build.js && node tools/serve.js",
    "serve": "node tools/serve.js",
    "api": "node api/_server.js",
    "dev": "node tools/dev.js",
    "test": "node --test \"api/_test/*.test.js\"",
    "migrate": "node api/_migrate.js",
    "start:prod": "node tools/build.js && node tools/serve.js",
    "build:vercel": "node tools/build.js && node tools/dist.js"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "pg-mem": "^3.0.14"
  },
  "type": "commonjs",
  "overrides": {
    "rpc-websockets": {
      "uuid": "^9.0.1"
    }
  }
}
